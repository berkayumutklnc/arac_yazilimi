# Üretim ortam değişkenleri — kopyalayıp VPS'te `.env.production` olarak
# kaydedin (`chmod 600`), gerçek değerleri girin. Bu dosya (`.env.production`)
# ASLA repo'ya commit edilmez (bkz. .gitignore, docs/runbook.md "Sır Yönetimi").
# Her sır `openssl rand -base64 32` ile üretilmeli — burada yalnızca
# placeholder'lar var, gerçek bir sır İÇERMEZ.

# --- İmaj registry (GHCR) ---
# ghcr.io/<github-kullanıcı-veya-organizasyon>/<repo-adı> — sondaki -api/-web/
# -diag-service son eki docker-compose.prod.yml tarafından otomatik eklenir.
GHCR_NAMESPACE=ghcr.io/CHANGE_ME/arac-yazilim
# scripts/deploy-remote.sh tarafından git tag'iyle enjekte edilir — elle
# çalıştırırken de üzerine yazılabilir (ör. rollback için önceki bir tag).
IMAGE_TAG=latest

# --- Alan adları (Caddy otomatik TLS) — GERÇEK domain hazır olunca değiştirin ---
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
WEB_APP_BASE_URL=https://app.example.com

# --- PostgreSQL ---
POSTGRES_USER=arac_yazilim
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=arac_yazilim

# --- Auth (bkz. ADR 0006) — sabit/varsayılan bir sırla başlatma reddedilir ---
JWT_ACCESS_SECRET=CHANGE_ME

# --- MinIO (S3 uyumlu ECU dosya deposu + yedekleme hedefi) ---
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_REGION=us-east-1
S3_BUCKET=arac-yazilim-ecu-files
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

# --- İlk SUPER_ADMIN bootstrap'i (bkz. ADR 0010) — yalnızca
# `docker compose run --rm api npm run bootstrap:platform-admin` çalıştırılırken
# okunur, normal sunucu başlatmada gerekmez ---
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_INITIAL_PASSWORD=CHANGE_ME

# --- Gözlemlenebilirlik minimumu (bkz. ADR 0015) ---
LOG_LEVEL=info
# Opsiyonel — verilmezse scripts/uptime-check.sh yalnızca yerel log dosyasına
# yazar, dışarı webhook göndermez.
UPTIME_WEBHOOK_URL=
