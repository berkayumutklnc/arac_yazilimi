{
  "openapi": "3.1.0",
  "info": {
    "title": "Diag Service",
    "version": "0.1.0"
  },
  "paths": {
    "/dtc/parse": {
      "post": {
        "tags": ["dtc"],
        "summary": "Parse Dtc File",
        "operationId": "parse_dtc_file_dtc_parse_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_parse_dtc_file_dtc_parse_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DtcParseResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/wot/analyze": {
      "post": {
        "tags": ["wot"],
        "summary": "Analyze Wot File",
        "operationId": "analyze_wot_file_wot_analyze_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_wot_file_wot_analyze_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WotAnalysisResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_analyze_wot_file_wot_analyze_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": ["file"],
        "title": "Body_analyze_wot_file_wot_analyze_post"
      },
      "Body_parse_dtc_file_dtc_parse_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": ["file"],
        "title": "Body_parse_dtc_file_dtc_parse_post"
      },
      "DtcMatch": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "known": {
            "type": "boolean",
            "title": "Known"
          }
        },
        "type": "object",
        "required": ["code", "description", "known"],
        "title": "DtcMatch"
      },
      "DtcParseResponse": {
        "properties": {
          "matches": {
            "items": {
              "$ref": "#/components/schemas/DtcMatch"
            },
            "type": "array",
            "title": "Matches"
          },
          "unknown_codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unknown Codes"
          }
        },
        "type": "object",
        "required": ["matches", "unknown_codes"],
        "title": "DtcParseResponse"
      },
      "Finding": {
        "properties": {
          "rule_id": {
            "type": "string",
            "title": "Rule Id"
          },
          "severity": {
            "type": "string",
            "title": "Severity"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "row_index": {
            "type": "integer",
            "title": "Row Index"
          },
          "details": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Details"
          }
        },
        "type": "object",
        "required": ["rule_id", "severity", "message", "row_index", "details"],
        "title": "Finding"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      },
      "WotAnalysisResponse": {
        "properties": {
          "row_count": {
            "type": "integer",
            "title": "Row Count"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Findings"
          }
        },
        "type": "object",
        "required": ["row_count", "findings"],
        "title": "WotAnalysisResponse"
      }
    }
  }
}
