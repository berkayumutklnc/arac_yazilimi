{
  "name": "arac-yazilim",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.22.1"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "audit-ci": "^7.1.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "apps/api/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "npm --prefix apps/api run test:related --"
    ],
    "packages/shared/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "npm --prefix packages/shared run test:related --"
    ],
    "apps/web/**/*.{ts,tsx}": [
      "npm --prefix apps/web run lint -- --fix"
    ],
    "**/*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
