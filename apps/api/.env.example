# apps/api ortam değişkenleri — kopyalayıp .env olarak kaydedin, gerçek değerleri girin.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/arac_yazilim?schema=public"
# Access token (JWT, 15dk) imzalama sırrı — zorunlu, varsayılanı yok (bkz. ADR 0006).
JWT_ACCESS_SECRET="change-me-to-a-long-random-value"
# Refresh token opak/rastgele üretilir (JWT değildir), DB'de yalnızca SHA-256
# hash'i saklanır — ayrı bir sır gerektirmez.
PORT=3001
