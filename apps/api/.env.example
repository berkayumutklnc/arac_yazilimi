# apps/api ortam değişkenleri — kopyalayıp .env olarak kaydedin, gerçek değerleri girin.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/arac_yazilim?schema=public"
# Entegrasyon testleri (npm run test:integration) için ayrı veritabanı —
# uygulama DB'sinden bağımsız, testler arasında serbestçe temizlenebilir.
DATABASE_URL_TEST="postgresql://postgres:CHANGE_ME@localhost:5432/arac_yazilim_test?schema=public"
# Access token (JWT, 15dk) imzalama sırrı — zorunlu, varsayılanı yok (bkz. ADR 0006).
JWT_ACCESS_SECRET="change-me-to-a-long-random-value"
# Refresh token opak/rastgele üretilir (JWT değildir), DB'de yalnızca SHA-256
# hash'i saklanır — ayrı bir sır gerektirmez.
PORT=3001
# ECU dosya deposu (S3 uyumlu — yerelde MinIO). Kurulum: docs/local-minio-setup.md
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="arac-yazilim-ecu-files"
S3_ACCESS_KEY_ID="CHANGE_ME"
S3_SECRET_ACCESS_KEY="CHANGE_ME"
S3_FORCE_PATH_STYLE="true"
# apps/diag-service (FastAPI) adresi — bkz. docs/adr/0009-workorder-diagnostic-report.md.
DIAG_SERVICE_URL="http://localhost:8000"
