// Prisma schema — Faz 1 MVP
// Karar notları: ../../docs/adr/0001-prisma-tenant-isolation.md, ../../docs/adr/0002-ecufile-stockromref-workorder-compliance.md, ../../docs/adr/0003-workorder-status-machine-audit-log.md, ../../docs/adr/0004-ecufile-upload-download-policy-audit.md, ../../docs/adr/0005-dealer-hub-file-request-credit.md, ../../docs/adr/0006-auth-tenant-scoping.md, ../../docs/adr/0007-credit-deduction-locking-strategy.md, ../../docs/adr/0008-access-denied-audit-log.md, ../../docs/adr/0009-workorder-diagnostic-report.md, ../../docs/adr/0010-super-admin-platform-tenant.md, ../../docs/adr/0011-invitation-model.md, ../../docs/adr/0012-tenant-user-management-audit.md, ../../docs/adr/0013-dealer-account-linking-status.md, ../../docs/adr/0014-invoice-billing-epic.md, ../../docs/adr/0015-production-deployment-architecture.md

// "native" yerel geliştirme (bu makinede Windows) içindir; linux-musl-openssl-3.0.x
// üretim Docker imajı (node:22-alpine, bkz. docs/adr/0015) için — Alpine musl
// libc kullanır, glibc hedefleriyle uyumlu değildir. İkisi de olmadan üretim
// container'ı "query engine bulunamadı" hatasıyla başlangıçta çöker.
generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ENGINEER
  RECEPTIONIST
  DEALER
  // Kiracılar-üstü platform yöneticisi (bkz. ADR 0010) — User.tenantId yine de
  // NOT NULL, sabit slug'lı ("__platform__") bir placeholder Tenant'a bağlanır.
  SUPER_ADMIN
}

// Ana zincir sıkı doğrusal (bkz. ADR 0003): DRAFT -> ACCEPTED -> IN_PROGRESS ->
// AWAITING_PARTS -> QUALITY_CHECK -> DELIVERED -> CLOSED. İki bilinçli dal:
// QUALITY_CHECK -> IN_PROGRESS (rework) ve {DRAFT,ACCEPTED,IN_PROGRESS,
// AWAITING_PARTS} -> CANCELLED (DELIVERED/CLOSED'dan iptal yok). Geçiş
// kuralları apps/api/src/modules/workorder/workOrderStatus.machine.ts içinde
// uygulanır.
enum WorkOrderStatus {
  DRAFT
  ACCEPTED
  IN_PROGRESS
  AWAITING_PARTS
  QUALITY_CHECK
  DELIVERED
  CLOSED
  CANCELLED
}

enum EcuFileType {
  ORIGINAL_STOCK
  STAGE1
  STAGE2
  CUSTOM
}

// bkz. ADR 0014. DRAFT -> ISSUED -> {PAID, VOID}; kısmi ödeme takibi kapsam dışı.
enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum WorkOrderItemType {
  SERVICE
  PART
}

// Türkiye KDV dilimleri (bkz. ADR 0014).
enum VatRate {
  RATE_0
  RATE_1
  RATE_10
  RATE_20
}

// Hub/dealer dosya talebi yaşam döngüsü (bkz. ADR 0005): dallanmalı durum makinesi,
// apps/api/src/modules/dealer/fileRequestStatus.machine.ts içinde uygulanır.
enum FileRequestStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  FULFILLED
  REJECTED
}

// Reddedilen erişim denemelerinin güvenlik izleme kaydı (bkz. ADR 0008,
// docs/security-audit.md DÜŞÜK-3) — yalnızca ECU dosyası indirme/yükleme
// route'larında kullanılır.
enum AccessDeniedResource {
  ECU_FILE_DOWNLOAD
  ECU_FILE_UPLOAD
}

enum AccessDeniedReason {
  FORBIDDEN_ROLE
  NOT_FOUND
}

// Kiracı-içi kullanıcı yönetimi audit log'unun eylem türleri (bkz. ADR 0012).
enum UserManagementAction {
  ROLE_CHANGED
  DEACTIVATED
}

// diag-service'in iki ucuna karşılık gelir (bkz. ADR 0009,
// packages/shared/openapi/diag-service.json): DTC = POST /dtc/parse,
// WOT = POST /wot/analyze.
enum DiagnosticReportType {
  DTC
  WOT
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  // Login sırasında hangi tenant'a giriş yapıldığını belirlemek için
  // (bkz. ADR 0006) — insan-okunur, benzersiz kimlik.
  slug      String   @unique
  createdAt DateTime @default(now())

  users                      User[]
  customers                  Customer[]
  vehicles                   Vehicle[]
  workOrders                 WorkOrder[]
  ecuFiles                   EcuFile[]
  invoices                   Invoice[]
  workOrderStatusAuditLogs   WorkOrderStatusAuditLog[]
  ecuFileDownloadAuditLogs   EcuFileDownloadAuditLog[]
  accessDeniedAuditLogs      AccessDeniedAuditLog[]
  workOrderDiagnosticReports WorkOrderDiagnosticReport[]
  invitations                Invitation[]
  userManagementAuditLogs    UserManagementAuditLog[]
  invoiceStatusAuditLogs     InvoiceStatusAuditLog[]

  dealerAccountsAsHub    DealerAccount[] @relation("HubAccounts")
  dealerAccountsAsDealer DealerAccount[] @relation("DealerAccounts")
  fileRequestsAsHub      FileRequest[]   @relation("HubFileRequests")
  fileRequestsAsDealer   FileRequest[]   @relation("DealerFileRequests")
}

model User {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  email         String
  passwordHash  String
  role          Role
  // NULL = aktif. Soft-flag (Customer.deletedAt deseni) — satır silinmez
  // (bkz. ADR 0012). Deaktivasyon anında tüm refresh token'ları iptal eder.
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())

  refreshTokens               RefreshToken[]
  managementAuditLogsAsTarget UserManagementAuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  // Ham token asla saklanmaz — yalnızca SHA-256 hash'i (bkz. ADR 0006).
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

// bkz. ADR 0011. Ham token asla saklanmaz — RefreshToken deseniyle aynı
// (yalnızca SHA-256 hash'i). Tenant-içi davetler (`request.tenantDb.invitation`)
// ve SUPER_ADMIN'in yeni-tenant-için-ilk-daveti/public redemption (ham
// `prisma.invitation.*`) aynı modeli paylaşır.
model Invitation {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  email      String
  role       Role
  tokenHash  String    @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  // v1'de hiç set edilmez — ileride bir revoke endpoint'i migration'sız eklenebilsin diye şimdiden var.
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

// bkz. ADR 0012. AccessDeniedAuditLog ile aynı "ayrı model + saf logX(db,params)"
// deseni — ama targetUserId burada bilinçli olarak FK'li (hedef her zaman
// aynı tenant içindeki gerçek bir User).
model UserManagementAuditLog {
  id           String               @id @default(uuid())
  tenantId     String
  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  actorId      String
  targetUserId String
  targetUser   User                 @relation(fields: [targetUserId], references: [id])
  action       UserManagementAction
  fromRole     Role?
  toRole       Role?
  createdAt    DateTime             @default(now())

  @@index([tenantId])
  @@index([targetUserId])
}

model Customer {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  fullName       String
  phoneHash      String
  nationalIdHash String?
  deletedAt      DateTime?

  vehicles Vehicle[]

  @@index([tenantId])
}

model Vehicle {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  plate      String
  vin        String?
  brand      String
  model      String
  year       Int

  workOrders   WorkOrder[]
  ecuFiles     EcuFile[]
  fileRequests FileRequest[]

  @@index([tenantId])
  @@index([tenantId, plate])
}

model ServiceType {
  id                 String  @id @default(uuid())
  name               String
  affectsEnginePower Boolean @default(false)

  workOrderItems WorkOrderItem[]
}

model WorkOrder {
  id                       String          @id @default(uuid())
  tenantId                 String
  tenant                   Tenant          @relation(fields: [tenantId], references: [id])
  vehicleId                String
  vehicle                  Vehicle         @relation(fields: [vehicleId], references: [id])
  engineerId               String?
  status                   WorkOrderStatus @default(DRAFT)
  requiresAitmRegistration Boolean         @default(false)
  createdAt                DateTime        @default(now())
  closedAt                 DateTime?

  items             WorkOrderItem[]
  complianceSteps   WorkOrderComplianceStep[]
  statusAuditLogs   WorkOrderStatusAuditLog[]
  diagnosticReports WorkOrderDiagnosticReport[]
  invoice           Invoice?

  @@index([tenantId])
}

// bkz. ADR 0014. serviceTypeId bilinçli olarak opsiyonel — bugün hiçbir route
// ServiceType listelemiyor/oluşturmuyor; hizmet/parça ayrımı itemType +
// serbest metin description ile yapılıyor. İş emri DELIVERED/CLOSED/CANCELLED
// olduğunda kalemler kilitlenir (bkz. workOrderItem.service.ts).
model WorkOrderItem {
  id             String            @id @default(uuid())
  workOrderId    String
  workOrder      WorkOrder         @relation(fields: [workOrderId], references: [id])
  itemType       WorkOrderItemType
  description    String
  serviceTypeId  String?
  serviceType    ServiceType?      @relation(fields: [serviceTypeId], references: [id])
  quantity       Int
  unitPriceKurus Int
  vatRate        VatRate
  // quantity * unitPriceKurus — iki tam sayının çarpımı, yuvarlama gerekmez.
  netAmountKurus Int
  // round_half_up(netAmountKurus * vatRate% / 100) — kesirli kuruş ortaya
  // çıkabilecek tek adım (bkz. invoiceMath.ts).
  vatAmountKurus Int
  lineTotalKurus Int
  createdAt      DateTime          @default(now())

  @@index([workOrderId])
}

model WorkOrderComplianceStep {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  stepName    String
  completedAt DateTime?

  @@index([workOrderId])
}

model WorkOrderStatusAuditLog {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  workOrderId String
  workOrder   WorkOrder       @relation(fields: [workOrderId], references: [id])
  fromStatus  WorkOrderStatus
  toStatus    WorkOrderStatus
  // Rework (QUALITY_CHECK -> IN_PROGRESS) ve iptal (-> CANCELLED) dallarında
  // zorunlu, normal zincir geçişlerinde null (bkz. ADR 0003 revizyonu).
  reason      String?
  changedBy   String
  changedAt   DateTime        @default(now())

  @@index([tenantId])
  @@index([workOrderId])
}

model EcuFile {
  id          String      @id @default(uuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  vehicleId   String
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id])
  fileType    EcuFileType
  storageKey  String
  checksum    String
  // Orijinal stock ROM'a zorunlu referans (CLAUDE.md kural 2).
  // ORIGINAL_STOCK dosyası kendi id'sine self-reference verir; STAGE/CUSTOM
  // dosyalar gerçek orijinali işaret etmek zorundadır. NOT NULL — yedeksiz kayıt oluşturulamaz.
  stockRomRef String
  stockRom    EcuFile     @relation("StockRomBackup", fields: [stockRomRef], references: [id])
  derivedFrom EcuFile[]   @relation("StockRomBackup")
  uploadedBy  String
  createdAt   DateTime    @default(now())

  downloadAuditLogs EcuFileDownloadAuditLog[]
  asReadFileIn      FileRequest[]             @relation("FileRequestReadFile")
  asResultFileIn    FileRequest?              @relation("FileRequestResultFile")

  // Aynı araç için aynı hash'e sahip iki kayıt oluşamaz — DB seviyesinde
  // garanti (bkz. ADR 0007). confirmEcuFileUpload'daki uygulama-seviyesi
  // findFirst+create check-then-act deseni tek başına yarış koşuluna karşı
  // yetersizdi; bu index eşzamanlı iki yüklemeden birini reddeder.
  @@unique([tenantId, vehicleId, checksum])
  @@index([tenantId])
  @@index([vehicleId])
}

model EcuFileDownloadAuditLog {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  ecuFileId        String
  ecuFile          EcuFile  @relation(fields: [ecuFileId], references: [id])
  downloadedBy     String
  downloadedByRole Role
  downloadedAt     DateTime @default(now())

  @@index([tenantId])
  @@index([ecuFileId])
}

// bkz. ADR 0008. resourceId BİLİNÇLİ OLARAK FK'siz ve nullable — var
// olmayan/başka tenant'a ait id'leri de (mevcut EcuFileDownloadAuditLog'un
// zorunlu FK'si nedeniyle yapamadığı bir şeyi) kaybetmeden loglayabilmek için.
model AccessDeniedAuditLog {
  id         String               @id @default(uuid())
  tenantId   String
  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  actorId    String
  actorRole  Role
  resource   AccessDeniedResource
  resourceId String?
  reason     AccessDeniedReason
  occurredAt DateTime             @default(now())

  @@index([tenantId])
}

// bkz. ADR 0009. `result`, diag-service'in (zod ile doğrulanmış) ham JSON
// yanıtını taşır — DTC (`matches`/`unknown_codes`) ve WOT (`row_count`/
// `findings`) şekilleri kökten farklı olduğu için ayrı normalize tablolar
// yerine bilinçli olarak Json seçildi.
model WorkOrderDiagnosticReport {
  id          String               @id @default(uuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  workOrderId String
  workOrder   WorkOrder            @relation(fields: [workOrderId], references: [id])
  reportType  DiagnosticReportType
  fileName    String
  result      Json
  uploadedBy  String
  createdAt   DateTime             @default(now())

  @@index([tenantId])
  @@index([workOrderId])
}

// bkz. ADR 0013. status'un varlığından önce bir DealerAccount satırının
// varlığı TEK BAŞINA "bağlantı kuruldu" demekti — artık hub OWNER'ı önerir
// (PENDING), yalnızca dealer OWNER'ı onaylar/reddeder (ACTIVE/REJECTED).
// @@unique([hubTenantId, dealerTenantId]) değişmedi — artık "bu çift için
// (durumu ne olursa olsun) tek kayıt" anlamına gelir (tekrar öneri engeli).
enum DealerAccountStatus {
  PENDING
  ACTIVE
  REJECTED
}

model DealerAccount {
  id                 String              @id @default(uuid())
  hubTenantId        String
  hubTenant          Tenant              @relation("HubAccounts", fields: [hubTenantId], references: [id])
  dealerTenantId     String
  dealerTenant       Tenant              @relation("DealerAccounts", fields: [dealerTenantId], references: [id])
  status             DealerAccountStatus @default(PENDING)
  requestedBy        String
  approvedBy         String?
  respondedAt        DateTime?
  creditBalanceKurus Int                 @default(0)
  createdAt          DateTime            @default(now())

  fileRequests FileRequest[]
  transactions DealerCreditTransaction[]

  @@unique([hubTenantId, dealerTenantId])
  @@index([hubTenantId])
  @@index([dealerTenantId])
}

model DealerCreditTransaction {
  id                String        @id @default(uuid())
  dealerAccountId   String
  dealerAccount     DealerAccount @relation(fields: [dealerAccountId], references: [id])
  // Düşüş için negatif değer; her para hareketinin denetlenebilir kaydı.
  amountKurus       Int
  balanceAfterKurus Int
  fileRequestId     String?
  fileRequest       FileRequest?  @relation(fields: [fileRequestId], references: [id])
  createdAt         DateTime      @default(now())

  @@index([dealerAccountId])
}

model FileRequest {
  id              String            @id @default(uuid())
  hubTenantId     String
  hubTenant       Tenant            @relation("HubFileRequests", fields: [hubTenantId], references: [id])
  dealerTenantId  String
  dealerTenant    Tenant            @relation("DealerFileRequests", fields: [dealerTenantId], references: [id])
  dealerAccountId String
  dealerAccount   DealerAccount     @relation(fields: [dealerAccountId], references: [id])
  vehicleId       String
  vehicle         Vehicle           @relation(fields: [vehicleId], references: [id])
  readFileId      String
  readFile        EcuFile           @relation("FileRequestReadFile", fields: [readFileId], references: [id])
  requestedStage  EcuFileType
  status          FileRequestStatus @default(PENDING)
  costKurus       Int?
  resultFileId    String?           @unique
  resultFile      EcuFile?          @relation("FileRequestResultFile", fields: [resultFileId], references: [id])
  requestedBy     String
  processedBy     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  statusAuditLogs    FileRequestStatusAuditLog[]
  creditTransactions DealerCreditTransaction[]

  @@index([hubTenantId])
  @@index([dealerTenantId])
  @@index([vehicleId])
}

model FileRequestStatusAuditLog {
  id             String            @id @default(uuid())
  fileRequestId  String
  fileRequest    FileRequest       @relation(fields: [fileRequestId], references: [id])
  hubTenantId    String
  dealerTenantId String
  fromStatus     FileRequestStatus
  toStatus       FileRequestStatus
  changedBy      String
  changedAt      DateTime          @default(now())

  @@index([fileRequestId])
}

// bkz. ADR 0014. invoiceNumber yalnızca ISSUED'da atanır (DRAFT'ta null) —
// Postgres'te NULL'lar @@unique dışı tutulduğu için çoklu DRAFT sorun değil.
model Invoice {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  workOrderId   String        @unique
  workOrder     WorkOrder     @relation(fields: [workOrderId], references: [id])
  status        InvoiceStatus @default(DRAFT)
  invoiceNumber String?
  issuedAt      DateTime?
  voidedAt      DateTime?
  totalKurus    Int
  createdAt     DateTime      @default(now())

  lines           InvoiceLine[]
  payments        Payment[]
  statusAuditLogs InvoiceStatusAuditLog[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
}

// WorkOrderItem'ın oluşturma anındaki ANLIK GÖRÜNTÜSÜ — sonradan kalem
// fiyatı/KDV'si değişse de fatura sabit kalır (bkz. ADR 0014).
model InvoiceLine {
  id             String  @id @default(uuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id])
  description    String
  quantity       Int
  unitPriceKurus Int
  vatRate        VatRate
  netAmountKurus Int
  vatAmountKurus Int
  lineTotalKurus Int

  @@index([invoiceId])
}

model Payment {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  amountKurus Int
  paidAt      DateTime @default(now())

  @@index([invoiceId])
}

// Tenant+yıl başına atomik, kilitli fatura sıra numarası sayacı — ADR 0007'nin
// DealerAccount kilitleme deseniyle birebir aynı (bkz. invoiceNumber.ts).
model InvoiceCounter {
  tenantId   String
  year       Int
  lastNumber Int    @default(0)

  @@id([tenantId, year])
}

// WorkOrderStatusAuditLog ile aynı desen (bkz. ADR 0014, ADR 0003).
model InvoiceStatusAuditLog {
  id         String        @id @default(uuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  invoiceId  String
  invoice    Invoice       @relation(fields: [invoiceId], references: [id])
  fromStatus InvoiceStatus
  toStatus   InvoiceStatus
  // Yalnızca VOID'de zorunlu (rework/iptal deseniyle aynı, bkz. ADR 0003).
  reason     String?
  changedBy  String
  changedAt  DateTime      @default(now())

  @@index([tenantId])
  @@index([invoiceId])
}
