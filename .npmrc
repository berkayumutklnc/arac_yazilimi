# engines.node zorunlu kılınır — Node 22.13.0'dan eski bir sürümle
# `npm install`/`npm ci` başarısız olur (bkz. .nvmrc, kök package.json
# engines). CI zaten actions/setup-node ile .nvmrc'yi okuyup doğru sürümü
# kullanıyor; bu yalnızca yerel makineleri de aynı standarda zorluyor.
engine-strict=true
